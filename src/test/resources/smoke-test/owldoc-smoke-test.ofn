Prefix(:=<http://example.org/owldoc#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/owldoc>
 Import(<http://example.org/owldoc/imported>)
 Declaration(Class(:Person))
 Declaration(Class(:Pet))
 Declaration(Class(:PetOwner))
 Declaration(Class(:café))
 Declaration(Class(:上吐下泻))
 Declaration(ObjectProperty(:owns))
 Declaration(DataProperty(:age))
 Declaration(NamedIndividual(:Alice))
 Declaration(NamedIndividual(:Rex))
 SubClassOf(:Pet <http://example.org/imported#Animal>)
 EquivalentClasses(:PetOwner ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:owns :Pet)))
 ObjectPropertyDomain(:owns :Person)
 ObjectPropertyRange(:owns :Pet)
 ClassAssertion(:Person :Alice)
 ClassAssertion(:Pet :Rex)
 ObjectPropertyAssertion(:owns :Alice :Rex)
 DataPropertyAssertion(:age :Alice "42"^^<http://www.w3.org/2001/XMLSchema#integer>)
 AnnotationAssertion(rdfs:comment :Person "café 上吐下泻 <tag> & text"@fr)
 AnnotationAssertion(rdfs:label :café "Café"@fr)
)
